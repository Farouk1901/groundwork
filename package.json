{
  "name": "groundwork-relate",
  "version": "1.0.0",
  "description": "The connected context of a ticket, before the first line of code: hybrid search over past tickets and fixes in a Relate graph, with the graph path behind every answer.",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "demo:ingest": "tsx src/cli.ts ingest --from docs/data/honojs__hono.json.gz",
    "demo": "tsx src/cli.ts ingest --from docs/data/honojs__hono.json.gz && tsx src/cli.ts serve",
    "start": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp",
    "eval": "tsx src/cli.ts eval honojs/hono",
    "cli": "tsx src/cli.ts",
    "site": "node scripts/build-site.mjs && node scripts/serve-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "bench:instant": "node scripts/bench-instant.mjs"
  },
  "keywords": [
    "relate",
    "neo4j",
    "graph",
    "mcp",
    "coding-agents",
    "github",
    "jira",
    "hybrid-search",
    "code-review"
  ],
  "author": "Ahmed Farouk",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@relate/relate": "1.0.1",
    "@relate/relate-wasm": "1.2.0",
    "cytoscape": "3.34.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Farouk1901/groundwork"
  },
  "engines": {
    "node": ">=20"
  }
}
